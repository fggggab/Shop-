{% comment %}
  Premium DIY Jewelry Designer
  ----------------------------------------------------------------------
  Online Store 2.0 section. Renders a step-by-step jewelry configurator
  with a sticky live preview. All copy is translatable (locales/*.json,
  namespace "jewelry_designer"); all product data is dynamic, sourced
  from section blocks (jewelry types / materials / sizes) and metaobject
  lists (beads / charms). See README.md for the metaobject + product
  setup this section expects.
{% endcomment %}

{%- liquid
  assign engraving_enabled = section.settings.engraving_enabled
  assign engraving_max_chars = section.settings.engraving_max_chars | default: 20
  assign placeholder_image = section.settings.placeholder_image | image_url: width: 1200

  assign beads = section.settings.beads_metaobjects.value
  assign charms = section.settings.charms_metaobjects.value

  assign jewelry_type_blocks = section.blocks | where: 'type', 'jewelry_type'
  assign material_blocks = section.blocks | where: 'type', 'material'
  assign size_blocks = section.blocks | where: 'type', 'size'

  assign engraving_fee_variant_id = blank
  if section.settings.engraving_fee_product != blank
    assign engraving_fee_variant_id = section.settings.engraving_fee_product.selected_or_first_available_variant.id
  endif
-%}

<section
  class="jd-root"
  data-jewelry-designer
  data-jd-storage-key="jd:designer:{{ section.id }}"
  aria-label="{{ 'jewelry_designer.aria_label' | t }}"
>
  <div class="jd-shell">
    <header class="jd-intro">
      {% if section.settings.heading != blank %}
        <p class="jd-step__eyebrow">{{ 'jewelry_designer.eyebrow' | t }}</p>
        <h1 class="jd-step__title" style="margin-bottom: 8px;">{{ section.settings.heading }}</h1>
      {% endif %}
      {% if section.settings.subheading != blank %}
        <p class="jd-step__desc">{{ section.settings.subheading }}</p>
      {% endif %}
    </header>

    {% render 'jd-progress-bar' %}

    <div class="jd-layout">
      <div class="jd-config-column">
        <div aria-live="polite" class="jd-visually-hidden" data-jd-live-region></div>

        {% render 'jd-step-jewelry-type', blocks: jewelry_type_blocks %}
        {% render 'jd-step-material', blocks: material_blocks %}
        {% render 'jd-step-beads', beads: beads %}
        {% render 'jd-step-charm', charms: charms %}
        {% render 'jd-step-size', blocks: size_blocks %}
        {% render 'jd-step-engraving', max_chars: engraving_max_chars, enabled: engraving_enabled, label: section.settings.engraving_label %}
        {% render 'jd-step-preview' %}
        {% render 'jd-summary' %}

        <nav class="jd-step-nav" aria-label="{{ 'jewelry_designer.nav_aria_label' | t }}">
          <button type="button" class="jd-btn jd-btn--ghost" data-jd-prev disabled>
            {{ 'jewelry_designer.actions.back' | t }}
          </button>
          <div style="display:flex; gap:8px;">
            <button type="button" class="jd-btn jd-btn--icon" data-jd-undo disabled aria-label="{{ 'jewelry_designer.actions.undo' | t }}">
              {% render 'jd-icon', name: 'undo' %}
            </button>
            <button type="button" class="jd-btn jd-btn--icon" data-jd-redo disabled aria-label="{{ 'jewelry_designer.actions.redo' | t }}">
              {% render 'jd-icon', name: 'redo' %}
            </button>
          </div>
          <button type="button" class="jd-btn jd-btn--primary" data-jd-next>
            {{ 'jewelry_designer.actions.next' | t }}
          </button>
        </nav>
      </div>

      {% render 'jd-preview-panel' %}
    </div>
  </div>

  <div class="jd-mobile-bar">
    <div>
      <p class="jd-mobile-bar__label">{{ 'jewelry_designer.preview.total' | t }}</p>
      <p class="jd-mobile-bar__price" data-jd-price>—</p>
    </div>
    <button type="button" class="jd-btn jd-btn--primary" data-jd-primary-cta>
      <span data-jd-primary-cta-label>{{ 'jewelry_designer.actions.continue_cta' | t }}</span>
    </button>
  </div>

  <div class="jd-toast" role="status" data-jd-toast></div>

  {%- comment -%} Structured config consumed by assets/jewelry-designer.js {%- endcomment -%}
  <script type="application/json" data-jd-config>
    {
      "currencyFormat": {{ shop.money_format | json }},
      "compareAtCents": {{ section.settings.compare_at_price | times: 100 | default: 0 }},
      "placeholderImage": {{ placeholder_image | json }},
      "engraving": {
        "enabled": {{ engraving_enabled }},
        "label": {{ section.settings.engraving_label | json }},
        "priceCents": {{ section.settings.engraving_price | times: 100 | default: 0 }},
        "maxChars": {{ engraving_max_chars }},
        "variantId": {{ engraving_fee_variant_id | default: 'null' }}
      },
      "delivery": {
        "standardDays": {{ section.settings.delivery_standard_days | json }},
        "engravingExtraDays": {{ section.settings.delivery_engraving_extra_days | default: 0 }}
      },
      "jewelryTypes": [
        {%- for block in jewelry_type_blocks -%}
          {%- liquid
            assign jt_product = block.settings.product
            assign jt_image = block.settings.image | image_url: width: 1200
            if jt_image == blank and jt_product != blank
              assign jt_image = jt_product.featured_image | image_url: width: 1200
            endif
          -%}
          {
            "id": {{ block.id | json }},
            "name": {{ block.settings.label | json }},
            "image": {{ jt_image | json }},
            "basePriceCents": {{ jt_product.selected_or_first_available_variant.price | default: 0 }},
            "variantMap": {
              {%- for variant in jt_product.variants -%}
                {%- assign material_id = '' -%}
                {%- assign size_id = '' -%}
                {%- for b in material_blocks -%}
                  {%- if b.settings.option_value != blank and variant.options contains b.settings.option_value -%}
                    {%- assign material_id = b.id -%}
                  {%- endif -%}
                {%- endfor -%}
                {%- for b in size_blocks -%}
                  {%- if b.settings.option_value != blank and variant.options contains b.settings.option_value -%}
                    {%- assign size_id = b.id -%}
                  {%- endif -%}
                {%- endfor -%}
                "{{ material_id }}|{{ size_id }}": {{ variant.id }}{% unless forloop.last %},{% endunless %}
              {%- endfor -%}
            }
          }{% unless forloop.last %},{% endunless %}
        {%- endfor -%}
      ],
      "materials": [
        {%- for block in material_blocks -%}
          {%- assign swatch_img = block.settings.swatch_image | image_url: width: 200 -%}
          {%- assign preview_img = block.settings.preview_image | image_url: width: 1200 -%}
          {
            "id": {{ block.id | json }},
            "name": {{ block.settings.label | json }},
            "swatchColor": {{ block.settings.swatch | json }},
            "swatchImage": {{ swatch_img | json }},
            "previewImage": {{ preview_img | json }},
            "priceModifierCents": {{ block.settings.price_adjustment | times: 100 | default: 0 }}
          }{% unless forloop.last %},{% endunless %}
        {%- endfor -%}
      ],
      "sizes": [
        {%- for block in size_blocks -%}
          {
            "id": {{ block.id | json }},
            "label": {{ block.settings.label | json }},
            "priceModifierCents": {{ block.settings.price_adjustment | times: 100 | default: 0 }}
          }{% unless forloop.last %},{% endunless %}
        {%- endfor -%}
      ],
      "beads": [
        {%- for bead in beads -%}
          {%- assign bead_variant = bead.variant.value -%}
          {%- assign bead_image = bead.image.value | image_url: width: 400 -%}
          {
            "id": {{ bead.id | json }},
            "name": {{ bead.name.value | json }},
            "image": {{ bead_image | json }},
            "priceCents": {{ bead_variant.price | times: 100 | default: 0 }},
            "variantId": {{ bead_variant.id | default: 'null' }}
          }{% unless forloop.last %},{% endunless %}
        {%- endfor -%}
      ],
      "charms": [
        {%- for charm in charms -%}
          {%- assign charm_variant = charm.variant.value -%}
          {%- assign charm_image = charm.image.value | image_url: width: 400 -%}
          {
            "id": {{ charm.id | json }},
            "name": {{ charm.name.value | json }},
            "image": {{ charm_image | json }},
            "priceCents": {{ charm_variant.price | times: 100 | default: 0 }},
            "variantId": {{ charm_variant.id | default: 'null' }}
          }{% unless forloop.last %},{% endunless %}
        {%- endfor -%}
      ],
      "i18n": {
        "adding": {{ 'jewelry_designer.js.adding' | t | json }},
        "added": {{ 'jewelry_designer.js.added' | t | json }},
        "addFailed": {{ 'jewelry_designer.js.add_failed' | t | json }},
        "savings": {{ 'jewelry_designer.js.savings' | t | json }},
        "noSelection": {{ 'jewelry_designer.js.no_selection' | t | json }},
        "included": {{ 'jewelry_designer.js.included' | t | json }},
        "continueCta": {{ 'jewelry_designer.actions.continue_cta' | t | json }},
        "addToCart": {{ 'jewelry_designer.actions.add_to_cart' | t | json }}
      }
    }
  </script>
</section>

<link rel="stylesheet" href="{{ 'jewelry-designer.css' | asset_url }}" media="all">
<script type="module" src="{{ 'jewelry-designer.js' | asset_url }}"></script>

{%- style -%}
  {{ section.settings.heading_font | font_face: font_display: 'swap' }}
  {{ section.settings.body_font | font_face: font_display: 'swap' }}

  #shopify-section-{{ section.id }} .jd-root {
    --font-heading-family: {{ section.settings.heading_font.family }}, serif;
    --font-heading-style: {{ section.settings.heading_font.style }};
    --font-heading-weight: {{ section.settings.heading_font.weight }};
    --font-body-family: {{ section.settings.body_font.family }}, sans-serif;
    --font-body-style: {{ section.settings.body_font.style }};
    --font-body-weight: {{ section.settings.body_font.weight }};
  }
{%- endstyle -%}

{% schema %}
{
  "name": "t:sections.jewelry_designer.name",
  "tag": "section",
  "class": "jd-section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "t:sections.jewelry_designer.settings.heading.label",
      "default": "Gestalte dein Unikat"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "t:sections.jewelry_designer.settings.subheading.label",
      "default": "Wähle jedes Detail deines Schmuckstücks – von der Fassung bis zur Gravur."
    },
    {
      "type": "header",
      "content": "t:sections.jewelry_designer.settings.header_beads_charms"
    },
    {
      "type": "metaobject_list",
      "id": "beads_metaobjects",
      "label": "t:sections.jewelry_designer.settings.beads_metaobjects.label",
      "metaobject_type": "bead"
    },
    {
      "type": "metaobject_list",
      "id": "charms_metaobjects",
      "label": "t:sections.jewelry_designer.settings.charms_metaobjects.label",
      "metaobject_type": "charm"
    },
    {
      "type": "header",
      "content": "t:sections.jewelry_designer.settings.header_engraving"
    },
    {
      "type": "checkbox",
      "id": "engraving_enabled",
      "label": "t:sections.jewelry_designer.settings.engraving_enabled.label",
      "default": true
    },
    {
      "type": "text",
      "id": "engraving_label",
      "label": "t:sections.jewelry_designer.settings.engraving_label.label",
      "default": "Gravur"
    },
    {
      "type": "number",
      "id": "engraving_price",
      "label": "t:sections.jewelry_designer.settings.engraving_price.label",
      "default": 0
    },
    {
      "type": "range",
      "id": "engraving_max_chars",
      "label": "t:sections.jewelry_designer.settings.engraving_max_chars.label",
      "min": 4,
      "max": 40,
      "step": 1,
      "default": 20
    },
    {
      "type": "product",
      "id": "engraving_fee_product",
      "label": "t:sections.jewelry_designer.settings.engraving_fee_product.label",
      "info": "t:sections.jewelry_designer.settings.engraving_fee_product.info"
    },
    {
      "type": "header",
      "content": "t:sections.jewelry_designer.settings.header_delivery"
    },
    {
      "type": "text",
      "id": "delivery_standard_days",
      "label": "t:sections.jewelry_designer.settings.delivery_standard_days.label",
      "default": "7–10"
    },
    {
      "type": "number",
      "id": "delivery_engraving_extra_days",
      "label": "t:sections.jewelry_designer.settings.delivery_engraving_extra_days.label",
      "default": 3
    },
    {
      "type": "header",
      "content": "t:sections.jewelry_designer.settings.header_pricing"
    },
    {
      "type": "number",
      "id": "compare_at_price",
      "label": "t:sections.jewelry_designer.settings.compare_at_price.label",
      "info": "t:sections.jewelry_designer.settings.compare_at_price.info"
    },
    {
      "type": "image_picker",
      "id": "placeholder_image",
      "label": "t:sections.jewelry_designer.settings.placeholder_image.label"
    },
    {
      "type": "header",
      "content": "t:sections.jewelry_designer.settings.header_typography"
    },
    {
      "type": "font_picker",
      "id": "heading_font",
      "label": "t:sections.jewelry_designer.settings.heading_font.label",
      "default": "playfair-display_n4"
    },
    {
      "type": "font_picker",
      "id": "body_font",
      "label": "t:sections.jewelry_designer.settings.body_font.label",
      "default": "assistant_n4"
    }
  ],
  "blocks": [
    {
      "type": "jewelry_type",
      "name": "t:sections.jewelry_designer.blocks.jewelry_type.name",
      "settings": [
        { "type": "text", "id": "label", "label": "t:sections.jewelry_designer.blocks.jewelry_type.settings.label.label", "default": "Armband" },
        { "type": "image_picker", "id": "image", "label": "t:sections.jewelry_designer.blocks.jewelry_type.settings.image.label" },
        { "type": "product", "id": "product", "label": "t:sections.jewelry_designer.blocks.jewelry_type.settings.product.label", "info": "t:sections.jewelry_designer.blocks.jewelry_type.settings.product.info" }
      ]
    },
    {
      "type": "material",
      "name": "t:sections.jewelry_designer.blocks.material.name",
      "settings": [
        { "type": "text", "id": "label", "label": "t:sections.jewelry_designer.blocks.material.settings.label.label", "default": "Gold" },
        { "type": "color", "id": "swatch", "label": "t:sections.jewelry_designer.blocks.material.settings.swatch.label", "default": "#C7A24A" },
        { "type": "image_picker", "id": "swatch_image", "label": "t:sections.jewelry_designer.blocks.material.settings.swatch_image.label" },
        { "type": "image_picker", "id": "preview_image", "label": "t:sections.jewelry_designer.blocks.material.settings.preview_image.label" },
        { "type": "number", "id": "price_adjustment", "label": "t:sections.jewelry_designer.blocks.material.settings.price_adjustment.label", "default": 0 },
        { "type": "text", "id": "option_value", "label": "t:sections.jewelry_designer.blocks.material.settings.option_value.label", "info": "t:sections.jewelry_designer.blocks.material.settings.option_value.info" }
      ]
    },
    {
      "type": "size",
      "name": "t:sections.jewelry_designer.blocks.size.name",
      "settings": [
        { "type": "text", "id": "label", "label": "t:sections.jewelry_designer.blocks.size.settings.label.label", "default": "S" },
        { "type": "number", "id": "price_adjustment", "label": "t:sections.jewelry_designer.blocks.size.settings.price_adjustment.label", "default": 0 },
        { "type": "text", "id": "option_value", "label": "t:sections.jewelry_designer.blocks.size.settings.option_value.label", "info": "t:sections.jewelry_designer.blocks.size.settings.option_value.info" }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:sections.jewelry_designer.presets.name",
      "blocks": [
        { "type": "jewelry_type", "settings": { "label": "Armband" } },
        { "type": "jewelry_type", "settings": { "label": "Halskette" } },
        { "type": "material", "settings": { "label": "Gold", "swatch": "#C7A24A", "option_value": "Gold" } },
        { "type": "material", "settings": { "label": "Silber", "swatch": "#C9CED6", "option_value": "Silber" } },
        { "type": "size", "settings": { "label": "S", "option_value": "S" } },
        { "type": "size", "settings": { "label": "M", "option_value": "M" } },
        { "type": "size", "settings": { "label": "L", "option_value": "L" } }
      ]
    }
  ]
}
{% endschema %}
