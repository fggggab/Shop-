{%- comment -%} Step 1: choose the piece of jewelry. Accepts `blocks` (section.blocks). {%- endcomment -%}

<section class="jd-step" data-jd-step="jewelryType" aria-labelledby="jd-heading-jewelry-type">
  <p class="jd-step__eyebrow">{{ 'jewelry_designer.progress.jewelry_type' | t }}</p>
  <h2 class="jd-step__title" id="jd-heading-jewelry-type" data-jd-step-heading>{{ 'jewelry_designer.steps.jewelry_type.title' | t }}</h2>
  <p class="jd-step__desc">{{ 'jewelry_designer.steps.jewelry_type.desc' | t }}</p>

  <div class="jd-option-grid" role="group" aria-label="{{ 'jewelry_designer.steps.jewelry_type.title' | t }}">
    {%- for block in blocks -%}
      {%- liquid
        assign img = block.settings.image | image_url: width: 400
        if img == blank and block.settings.product != blank
          assign img = block.settings.product.featured_image | image_url: width: 400
        endif
      -%}
      <button
        type="button"
        class="jd-card"
        data-jd-option="jewelryType"
        data-jd-value="{{ block.id }}"
        aria-pressed="false"
        {{ block.shopify_attributes }}
      >
        <span class="jd-card__media">
          {%- if img != blank -%}
            <img
              src="{{ img }}"
              srcset="{{ block.settings.image | image_url: width: 200 }} 200w, {{ img }} 400w, {{ block.settings.image | image_url: width: 800 }} 800w"
              sizes="(min-width: 560px) 200px, 45vw"
              width="400"
              height="400"
              alt="{{ block.settings.label | escape }}"
              loading="lazy"
              decoding="async"
            >
          {%- endif -%}
        </span>
        <span class="jd-card__check">{% render 'jd-icon', name: 'check' %}</span>
        <span class="jd-card__name">{{ block.settings.label }}</span>
      </button>
    {%- endfor -%}
  </div>
</section>
