{%- comment -%}
  Persistent live preview: sticky on desktop, feeds data-jd-preview-* hooks
  shared with the "preview" step and the mobile bar (see
  assets/jd-preview.js, which updates every matching element in one pass).
{%- endcomment -%}

<aside class="jd-preview" aria-label="{{ 'jewelry_designer.preview.aria_label' | t }}">
  <div class="jd-preview__stage" data-jd-preview-stage>
    <img data-jd-preview-image class="jd-preview__image" alt="{{ 'jewelry_designer.preview.image_alt' | t }}" loading="lazy" decoding="async" width="900" height="1125">
    <p class="jd-preview__engraving" data-jd-preview-engraving hidden></p>
    <span class="jd-preview__badge">{{ 'jewelry_designer.preview.badge' | t }}</span>
  </div>

  <div class="jd-preview__body">
    <div class="jd-preview__price-row">
      <div>
        <p class="jd-mobile-bar__label" style="margin:0 0 2px;">{{ 'jewelry_designer.preview.total' | t }}</p>
        <p class="jd-preview__price" data-jd-price>—</p>
      </div>
      <div style="text-align:right;">
        <p class="jd-preview__compare" data-jd-preview-compare hidden></p>
        <p class="jd-preview__savings" data-jd-preview-savings hidden></p>
      </div>
    </div>

    <dl class="jd-preview__list" data-jd-preview-list></dl>

    <p class="jd-preview__delivery" data-jd-delivery>
      {% render 'jd-icon', name: 'truck' %}
      <span>
        {{ 'jewelry_designer.preview.delivery_label' | t }}
        <strong><span data-jd-delivery-days>–</span> {{ 'jewelry_designer.preview.delivery_unit' | t }}</strong>
      </span>
    </p>

    <button type="button" class="jd-btn jd-btn--primary jd-preview__cta" data-jd-primary-cta>
      <span data-jd-primary-cta-label>{{ 'jewelry_designer.actions.continue_cta' | t }}</span>
    </button>

    <p class="jd-preview__trust">{{ 'jewelry_designer.preview.trust' | t }}</p>
  </div>
</aside>
