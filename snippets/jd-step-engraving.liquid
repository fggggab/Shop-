{%- comment -%}
  Step 6: optional engraving. Accepts `max_chars`, `enabled`, `label`.
{%- endcomment -%}

<section class="jd-step" data-jd-step="engraving" hidden aria-labelledby="jd-heading-engraving">
  <p class="jd-step__eyebrow">{{ 'jewelry_designer.progress.engraving' | t }}</p>
  <h2 class="jd-step__title" id="jd-heading-engraving" data-jd-step-heading>{{ 'jewelry_designer.steps.engraving.title' | t }}</h2>
  <p class="jd-step__desc">{{ 'jewelry_designer.steps.engraving.desc' | t }}</p>

  <div class="jd-engrave">
    {%- if enabled -%}
      {%- assign toggle_label = label | default: '' -%}
      {%- if toggle_label == blank -%}
        {%- assign toggle_label = 'jewelry_designer.steps.engraving.toggle_label' | t -%}
      {%- endif -%}
      <div class="jd-toggle-row">
        <div>
          <p class="jd-card__name" style="margin:0;">{{ toggle_label }}</p>
          <p class="jd-card__meta" style="margin:0;">{{ 'jewelry_designer.steps.engraving.toggle_hint' | t }}</p>
        </div>
        <button
          type="button"
          class="jd-switch"
          role="switch"
          aria-checked="false"
          aria-label="{{ 'jewelry_designer.steps.engraving.toggle_label' | t }}"
          data-jd-engrave-toggle
        ></button>
      </div>

      <div data-jd-engrave-text-wrap hidden>
        <label class="jd-field-label" for="jd-engrave-input">{{ 'jewelry_designer.steps.engraving.input_label' | t }}</label>
        <input
          type="text"
          id="jd-engrave-input"
          class="jd-input"
          data-jd-engrave-text
          maxlength="{{ max_chars }}"
          autocomplete="off"
          placeholder="{{ 'jewelry_designer.steps.engraving.placeholder' | t }}"
        >
        <div class="jd-input-hint" data-jd-engrave-hint data-over="false">
          <span>{{ 'jewelry_designer.steps.engraving.hint' | t }}</span>
          <span><span data-jd-engrave-count>0</span>/{{ max_chars }}</span>
        </div>
      </div>
    {%- else -%}
      <p class="jd-step__desc">{{ 'jewelry_designer.steps.engraving.unavailable' | t }}</p>
    {%- endif -%}
  </div>
</section>
