{%- comment -%}
  Inline SVG icon helper. Usage: {% render 'jd-icon', name: 'check' %}
  Keeping icons inline (no icon font/library) avoids an extra request and
  lets each icon inherit `currentColor`.
{%- endcomment -%}

{%- case name -%}
  {%- when 'check' -%}
    <svg viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M3.5 8.5L6.5 11.5L12.5 4.5" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
  {%- when 'undo' -%}
    <svg viewBox="0 0 20 20" fill="none" aria-hidden="true"><path d="M5 8H12.5C14.9853 8 17 10.0147 17 12.5C17 14.9853 14.9853 17 12.5 17H8" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/><path d="M8 4.5L4.5 8L8 11.5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
  {%- when 'redo' -%}
    <svg viewBox="0 0 20 20" fill="none" aria-hidden="true"><path d="M15 8H7.5C5.01472 8 3 10.0147 3 12.5C3 14.9853 5.01472 17 7.5 17H12" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/><path d="M12 4.5L15.5 8L12 11.5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
  {%- when 'truck' -%}
    <svg viewBox="0 0 20 20" fill="none" aria-hidden="true"><path d="M2 5.5H11.5V13H2V5.5Z" stroke="currentColor" stroke-width="1.4"/><path d="M11.5 8H14.5L17 10.5V13H11.5V8Z" stroke="currentColor" stroke-width="1.4"/><circle cx="5.5" cy="14.5" r="1.5" stroke="currentColor" stroke-width="1.3"/><circle cx="14" cy="14.5" r="1.5" stroke="currentColor" stroke-width="1.3"/></svg>
  {%- when 'minus' -%}
    <svg viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M3.5 8H12.5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg>
  {%- when 'plus' -%}
    <svg viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M8 3.5V12.5M3.5 8H12.5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg>
  {%- when 'edit' -%}
    <svg viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M11 2.5L13.5 5L6 12.5L2.5 13.5L3.5 10L11 2.5Z" stroke="currentColor" stroke-width="1.3" stroke-linejoin="round"/></svg>
{%- endcase -%}
