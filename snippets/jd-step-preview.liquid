{%- comment -%}
  Step 7: enlarged live-preview review. The sticky panel (jd-preview-panel)
  already shows the preview at all times; this step gives it full focus
  before the customer reaches the summary. Shares the same data-jd-preview-*
  hooks, so assets/jd-preview.js updates every instance in one render pass.
{%- endcomment -%}

<section class="jd-step" data-jd-step="preview" hidden aria-labelledby="jd-heading-preview">
  <p class="jd-step__eyebrow">{{ 'jewelry_designer.progress.preview' | t }}</p>
  <h2 class="jd-step__title" id="jd-heading-preview" data-jd-step-heading>{{ 'jewelry_designer.steps.preview.title' | t }}</h2>
  <p class="jd-step__desc">{{ 'jewelry_designer.steps.preview.desc' | t }}</p>

  <div class="jd-preview__stage" data-jd-preview-stage style="border-radius: var(--jd-radius-lg); border: 1px solid var(--jd-navy-100); max-width: 480px;">
    <img data-jd-preview-image class="jd-preview__image" alt="{{ 'jewelry_designer.steps.preview.image_alt' | t }}" loading="lazy" decoding="async" width="900" height="1125">
    <p class="jd-preview__engraving" data-jd-preview-engraving hidden></p>
    <span class="jd-preview__badge">{{ 'jewelry_designer.steps.preview.badge' | t }}</span>
  </div>
</section>
