{%- comment -%}
  Step 8: summary + "In den Warenkorb". Each card links back to the step
  it summarizes via data-jd-summary-edit (dispatches jd:goto-step).
{%- endcomment -%}

<section class="jd-step" data-jd-step="summary" hidden aria-labelledby="jd-heading-summary">
  <p class="jd-step__eyebrow">{{ 'jewelry_designer.progress.summary' | t }}</p>
  <h2 class="jd-step__title" id="jd-heading-summary" data-jd-step-heading>{{ 'jewelry_designer.steps.summary.title' | t }}</h2>
  <p class="jd-step__desc">{{ 'jewelry_designer.steps.summary.desc' | t }}</p>

  <dl class="jd-preview__list" data-jd-preview-list="compact" style="border:none; padding:0; margin-bottom: var(--jd-space-5);"></dl>

  <div class="jd-summary-grid">
    {%- assign summary_steps = 'jewelryType,material,beads,charm,size,engraving' | split: ',' -%}
    {%- for step_id in summary_steps -%}
      <div class="jd-summary-card">
        <div>
          <p class="jd-summary-card__title">{{ 'jewelry_designer.progress.' | append: step_id | t }}</p>
          <p class="jd-summary-card__value" data-jd-summary-value="{{ step_id }}">{{ 'jewelry_designer.js.no_selection' | t }}</p>
        </div>
        <button type="button" class="jd-btn jd-btn--text jd-summary-card__edit" data-jd-summary-edit="{{ step_id }}">
          {% render 'jd-icon', name: 'edit' %}
          {{ 'jewelry_designer.actions.edit' | t }}
        </button>
      </div>
    {%- endfor -%}
  </div>

  <button type="button" class="jd-btn jd-btn--primary" data-jd-add-to-cart style="margin-top: var(--jd-space-6); width: 100%;">
    <span data-jd-add-to-cart-label>{{ 'jewelry_designer.actions.add_to_cart' | t }}</span>
  </button>
</section>
