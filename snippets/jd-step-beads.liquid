{%- comment -%}
  Step 3: add beads. Accepts `beads` (array of `bead` metaobjects).
  Each bead metaobject is expected to expose: name, image, variant
  (variant_reference — used for both price and Ajax Cart line item id).
{%- endcomment -%}

<section class="jd-step" data-jd-step="beads" hidden aria-labelledby="jd-heading-beads">
  <p class="jd-step__eyebrow">{{ 'jewelry_designer.progress.beads' | t }}</p>
  <h2 class="jd-step__title" id="jd-heading-beads" data-jd-step-heading>{{ 'jewelry_designer.steps.beads.title' | t }}</h2>
  <p class="jd-step__desc">{{ 'jewelry_designer.steps.beads.desc' | t }}</p>

  <div class="jd-option-grid" role="group" aria-label="{{ 'jewelry_designer.steps.beads.title' | t }}">
    {%- for bead in beads -%}
      {%- assign bead_variant = bead.variant.value -%}
      <div class="jd-card jd-card--bead" data-jd-option="bead" data-jd-value="{{ bead.id }}" data-qty="0">
        <span class="jd-card__media">
          {%- if bead.image.value != blank -%}
            <img
              src="{{ bead.image.value | image_url: width: 400 }}"
              srcset="{{ bead.image.value | image_url: width: 200 }} 200w, {{ bead.image.value | image_url: width: 400 }} 400w"
              sizes="(min-width: 560px) 150px, 30vw"
              width="400" height="400"
              alt="{{ bead.name.value | escape }}"
              loading="lazy" decoding="async"
            >
          {%- endif -%}
        </span>
        <span class="jd-card__qty" data-jd-bead-qty-value>0</span>
        <span class="jd-card__name">{{ bead.name.value }}</span>
        {%- if bead_variant.price > 0 -%}
          <span class="jd-card__price">+{{ bead_variant.price | money_without_trailing_zeros }}</span>
        {%- endif -%}
        <span style="display:flex; align-items:center; justify-content:space-between; margin-top:4px;">
          <button type="button" class="jd-btn jd-btn--icon" style="width:30px;height:30px;" data-jd-bead-dec="{{ bead.id }}" disabled aria-label="{{ 'jewelry_designer.steps.beads.remove' | t: name: bead.name.value }}">
            {% render 'jd-icon', name: 'minus' %}
          </button>
          <button type="button" class="jd-btn jd-btn--icon" style="width:30px;height:30px;" data-jd-bead-inc="{{ bead.id }}" aria-label="{{ 'jewelry_designer.steps.beads.add' | t: name: bead.name.value }}">
            {% render 'jd-icon', name: 'plus' %}
          </button>
        </span>
      </div>
    {%- endfor -%}
  </div>
</section>
